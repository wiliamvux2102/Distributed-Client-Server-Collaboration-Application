@startuml
title SD-01 - Real-Time Direct and Broadcast Chat\nTrace: /msg & /all

hide footbox

skinparam backgroundColor white
skinparam shadowing false
skinparam roundcorner 0
skinparam dpi 160
skinparam defaultFontName Arial
skinparam defaultFontSize 13

skinparam sequence {
    ArrowColor #222222
    ArrowThickness 1
    LifeLineBorderColor #777777
    LifeLineBackgroundColor white
    ParticipantBorderColor #333333
    ParticipantFontColor #111111
    ParticipantBackgroundColor white
    ActorBorderColor #333333
    ActorFontColor #111111
    ActorBackgroundColor white
    ActivationBorderColor #555555
    ActivationBackgroundColor #8FD3F4
    GroupBorderColor #333333
    GroupBackgroundColor white
    GroupHeaderBackgroundColor white
    GroupHeaderFontColor #111111
    GroupFontColor #111111
    MessageAlign center
}

skinparam ParticipantPadding 20
skinparam BoxPadding 8

actor Alice as "Sender (Alice)" #C8F08C
participant "senderUI : CLI" as SUI #F2D98B
participant "senderChat : ClientChat" as SChat #AFC6E9
participant "serverWorker : Server" as Server #AFC6E9
participant "chatHandler : ChatServerHandler" as Handler #B8D99A
participant "receiverChat : ClientChat" as RChat #AFC6E9
participant "receiverUI : CLI" as RUI #F2D98B
actor Bob as "Receiver (Bob)" #C8F08C

alt Direct message (/msg bob <text>)

    Alice -> SUI : /msg bob Hello Bob!
    activate Alice #C792BE
    activate SUI #8FD3F4

    SUI -> SChat : send_direct("bob", "Hello Bob!")
    activate SChat #8FD3F4

    SChat -> Server : DIRECT_MESSAGE(recipient="bob", text)
    activate Server #8FD3F4

    Server -> Handler : dispatch(context, message)
    activate Handler #8FD3F4

    Handler -> Handler : validate recipient != sender\nvalidate UTF-8 & payload size

    alt Recipient offline or invalid

        Handler --> Server : DELIVERY_STATUS(ok=False, code)
        Server --> SChat : relay DELIVERY_STATUS
        SChat --> SUI : on_status(error)
        SUI ->> Alice : display error

        note over Server,Handler
            Codes: RECIPIENT_OFFLINE,
            RECIPIENT_SELF, MESSAGE_TOO_LARGE.
        end note

    else Recipient online

        Handler -> RChat : send_to_user(DIRECT_DELIVERY)
        activate RChat #8FD3F4
        RChat -> RUI : on_message("alice", text, is_broadcast=False)
        activate RUI #8FD3F4
        RUI ->> Bob : display "[RIÊNG từ alice] Hello Bob!"
        deactivate RUI
        deactivate RChat

        Handler --> Server : DELIVERY_STATUS(ok=True)
        Server --> SChat : relay DELIVERY_STATUS
        SChat --> SUI : on_status(delivered)
        SUI ->> Alice : display "[ĐÃ GỬI] Đã chuyển tin tới bob."

    end

    deactivate Handler
    deactivate Server
    deactivate SChat
    deactivate SUI
    deactivate Alice

else Broadcast message (/all <text>)

    Alice -> SUI : /all Hello everyone!
    activate Alice #C792BE
    activate SUI #8FD3F4

    SUI -> SChat : send_broadcast("Hello everyone!")
    activate SChat #8FD3F4

    SChat -> Server : BROADCAST_MESSAGE(text)
    activate Server #8FD3F4

    Server -> Handler : dispatch(context, message)
    activate Handler #8FD3F4

    Handler -> Handler : validate UTF-8 & payload size\nquery online users

    loop For each online user != Alice

        Handler -> RChat : send_to_user(BROADCAST_DELIVERY)
        activate RChat #8FD3F4
        RChat -> RUI : on_message("alice", text, is_broadcast=True)
        activate RUI #8FD3F4
        RUI ->> Bob : display "[CHUNG alice] Hello everyone!"
        deactivate RUI
        deactivate RChat

    end

    Handler --> Server : DELIVERY_STATUS(ok=True, delivered_count=N)
    Server --> SChat : relay DELIVERY_STATUS
    SChat --> SUI : on_status(delivered_count)
    SUI ->> Alice : display "[ĐÃ GỬI] Đã phát tin tới N người dùng đang online."

    deactivate Handler
    deactivate Server
    deactivate SChat
    deactivate SUI
    deactivate Alice

end

@enduml
